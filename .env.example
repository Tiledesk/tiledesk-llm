# Tiledesk LLM Environment Variables
# Copy this file to .env and fill in the values for your local development.

# --- Application Profile ---
# Select the profile to run: 'app-base', 'app-graph', 'app-ocr', 'app-all'
# When set, this automatically enables the appropriate modules
# If set, individual module flags below are ignored
TILELLM_PROFILE="app-base"

# --- Module Configuration (only used if TILELLM_PROFILE is not set) ---
# Set to 'true' to enable each module
ENABLE_TASKIQ="true"
ENABLE_GRAPHRAG="false"
ENABLE_GRAPHRAG_FALKOR="true"
ENABLE_RAPTOR="false"
ENABLE_PDF_OCR="false"
ENABLE_CONVERSION="true"
ENABLE_TOOLS_REGISTRY="true"
ENABLE_LGRAPH="true"
ENABLE_SYSTEM_ONE="true"         # POST /api/v1/systemone (Jev, laya-serve, clm-serve)



# --- Redis Configuration ---
REDIS_URL="redis://localhost:6379/0"

# --- Neo4j Configuration (for Knowledge Graph) ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"
NEO4J_DATABASE="neo4j"

# --- FalkorDB Configuration (alternative Graph Database) ---
# FalkorDB runs on port 6380 by default (separate from Redis on 6379)
FALKORDB_URI="redis://localhost:6380/0"  # Optional, defaults to REDIS_URL (port 6379)
FALKORDB_MAX_CONNECTIONS="50"
FALKORDB_SOCKET_TIMEOUT="30.0"
FALKORDB_SOCKET_CONNECT_TIMEOUT="10.0"
FALKORDB_SOCKET_KEEPALIVE="True"
FALKORDB_RETRY_ON_TIMEOUT="True"

# --- MinIO Configuration (for GraphRAG artifact storage) ---
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE="False"
MINIO_GRAPHRAG_BUCKET="graphrag"
MINIO_TABLES_BUCKET="document-tables"
MINIO_IMAGES_BUCKET="document-images"
MINIO_PDFS_BUCKET="ocr-pdfs"

# --- TEI (Text Embeddings Inference) Configuration ---
TEI_EMBEDDING_URL="http://localhost:7580"
TEI_EMBEDDING_API_KEY=""
TEI_EMBEDDING_MODEL="intfloat/multilingual-e5-large-instruct"

TEI_SPARSE_ENCODER_URL="http://localhost:7380"
TEI_SPARSE_ENCODER_API_KEY=""
TEI_SPARSE_ENCODER_MODEL="naver/efficient-splade-VI-BT-large-query"

TEI_RERANKER_URL="http://localhost:7480"
TEI_RERANKER_API_KEY=""
TEI_RERANKER_MODEL="BAAI/bge-reranker-large"

# --- System One servers (docker-compose-redis-tei-qdrant.yml, profiles "laya" and "clm") ---
# Both expose the Jev-compatible POST /v1/systemone. Empty values = server default.
# Laya (profile "laya", host port LAYA_HOST_PORT, default 8710)
LAYA_VERSION="0.3.27"
LAYA_DEVICE=""                 # "", cpu, cuda (empty = auto)
LAYA_MODELS=""                 # comma list to preload: english,multilingual,typed-decisions or /models/<fine-tuned-dir>
LAYA_MAX_LOADED="2"
LAYA_IDLE_UNLOAD_SECONDS="0"
LAYA_JEV_STRICT="0"            # 1 = strict Jev wire contract (no extra fields like "routing")
LAYA_API_KEY=""                # empty = no auth
LAYA_CHECKPOINTS_DIR="~/sviluppo/data/laya_checkpoints"   # mounted read-only at /models
# CLM (profile "clm": clm-encoder = Qwen3-8B on vLLM, needs a GPU with >= 16 GB; clm-serve on CLM_HOST_PORT, default 8700)
CLM_VERSION="0.1.0"
VLLM_IMAGE="vllm/vllm-openai:latest"
CLM_ENCODER_MODEL="Qwen/Qwen3-8B"
CLM_MAX_TOKENS="2048"          # encoder max-model-len = state truncation limit
CLM_ENCODER_GPU_UTIL="0.85"
CLM_DEVICE="cpu"               # device for the small projection heads
CLM_ACTION_CACHE="0"
CLM_API_KEY=""                 # empty = no auth
CLM_CHECKPOINTS_DIR="~/sviluppo/data/clm_checkpoints"     # <name>.pt files served as model "<name>"

# --- Application Settings ---
# Role for the LLM worker ('api' or 'train')
TILELLM_ROLE="api"
LOG_LEVEL="INFO"

# Enable profiler (True/False)
ENABLE_PROFILER="False"

# Redis Queue Name (for OCR processing)
REDIS_QUEUE_NAME="tiledesk_ocr_queue"

# --- PDF OCR pipeline concurrency ---
# Maximum number of PDF documents processed simultaneously within a single TaskIQ worker.
# Keep at 1 on single-GPU pods to avoid OOM; raise to 2 only on multi-GPU or CPU-only hosts.
PDF_MAX_CONCURRENT="1"

# --- Situated context (Contextual Retrieval) concurrency ---
# Max concurrent LLM calls during situated-context chunk enrichment. Multiplied
# by TASKIQ_MAX_ASYNC_TASKS for the real concurrency hitting the LLM endpoint —
# that combination saturated a RunPod LLM endpoint once (2026-07-27). Lower it
# alongside PDF_MAX_CONCURRENT if you see similar rate-limit/timeout errors.
SITUATED_CONTEXT_MAX_CONCURRENT="5"

# PDF OCR idempotency guard TTLs (seconds).
# completed: how long a successfully indexed doc is protected from re-ingestion (default 7 days).
# failed:    cooldown before a failed doc can be re-submitted (default 1 hour).
# active:    safety TTL for queued/processing state in case a worker crashes (default 2 hours).
PDF_OCR_DEDUP_COMPLETED_TTL="604800"
PDF_OCR_DEDUP_FAILED_TTL="3600"
PDF_OCR_DEDUP_ACTIVE_TTL="7200"

# --- JWT Secret Key ---
JWT_SECRET_KEY="your-secret-key-of-256-bit"

# --- RAPTOR Configuration (Hierarchical Summarization) ---
RAPTOR_CLUSTER_SIZE="5"
RAPTOR_MAX_LEVELS="3"
RAPTOR_MIN_PAGES="10"
RAPTOR_ENABLED_DOC_TYPES="accademico,tecnico,legale,scientifico"
RAPTOR_SUMMARY_MAX_TOKENS="512"
RAPTOR_SUMMARY_TEMPERATURE="0.3"
RAPTOR_RETRIEVAL_STRATEGY="collapsed_tree"
RAPTOR_TOP_K_PER_LEVEL="3"
RAPTOR_USE_RRF="true"
RAPTOR_RRF_K="60"

# RAPTOR Clustering (optional, requires: poetry install --extras "raptor")
RAPTOR_CLUSTERING_METHOD="raptor"       # "raptor" (UMAP+GMM) or "sequential"
RAPTOR_CLUSTERING_DIM="10"              # UMAP reduction dimension
RAPTOR_CLUSTERING_THRESHOLD="0.1"       # GMM probability threshold
RAPTOR_CLUSTERING_VERBOSE="false"

# RAPTOR Hybrid Search
RAPTOR_USE_HYBRID="false"
RAPTOR_HYBRID_ALPHA="0.7"
RAPTOR_SPARSE_ENCODER="splade"

# Outbound URLs from the request (file_content, source, *_url, webhook) — SSRF guard.
# Always blocked: non-http(s) schemes, loopback, link-local/cloud metadata (169.254.169.254).
OUTBOUND_ALLOW_PRIVATE_NETWORKS="true"   # "false" also blocks 10.x/172.16.x/192.168.x
OUTBOUND_URL_ALLOWED_HOSTS=""            # comma-separated hosts that bypass every check (e.g. "minio,localhost")
